# Copy this file to .env.local and fill in values for local development.

# --- Database (PostgreSQL, e.g. Neon) ---
# Required to run the app and tests.
DATABASE_URL=

# --- Development-only identity (DO NOT SET IN PRODUCTION) ---
# When DEV_AUTH_USER_ID and DEV_AUTH_SPACE_ID are both set, the server
# treats the request as if it came from that user/space, provided a
# matching membership row exists in the dev identity tables.
# The dev identity tables live in the "notes_dev_identity" schema and
# are ONLY meant for local development and tests. They will be removed
# once the central Couple Space SSO is wired in.
DEV_AUTH_USER_ID=
DEV_AUTH_SPACE_ID=

# --- Local development-only UI access mode (DO NOT SET IN PRODUCTION) ---
# When NOTES_DEV_UI=true, the server bypasses the dev identity check and
# serves the existing Notes UI against a synthetic ("dev-ui") Couple Space.
# This lets you inspect /notes and /notes/[id] locally without the future
# central Couple Space authentication app. No persistent data is created;
# the dashboard shows the real empty state. Saving from the editor will
# fail with 404 (no DB row to update) — use the dashboard "New note" button
# to create a real note for full inspection of the CRUD path.
#
# This flag is HARD-disabled in production (NODE_ENV === "production").
NOTES_DEV_UI=
